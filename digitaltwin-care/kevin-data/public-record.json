  "samples": [
    [
      "2024-07-06",
      "Left pleural fluid",
      "EML4-ALK, TP53 R282W and MYC amplification. PD-L1 CPS <1. Microsatellite stable.",
      "Tumor fraction reported at 10%, near the assay’s detection limit. TMB unavailable."
    ],
    [
      "2024-07-17",
      "Blood",
      "Guardant360 reported EML4-ALK at 0.07%. MSI-high was not detected.",
      "Blood and pleural fluid both reported the fusion."
    ],
    [
      "2026-01-21",
      "Left lower-lobe lung lesion",
      "Adenocarcinoma. RNA showed EML4-ALK. DNA showed BRAF V600E, TP53 R282W and an EGFR variant of uncertain significance. TMB 3 mut/Mb, microsatellite stable. PD-L1 TPS 7%.",
      "ALK 3+ in 100%; MET 2+ in 80%, reported negative; MET amplification not detected; HER2 0. SP142: tumor 0%, immune cells 1%, reported negative. AE1/AE3, CK7 and TTF positive."
    ],
    [
      "2026-07-09",
      "Left pleural nodule",
      "Metastatic adenocarcinoma consistent with the lung primary. ALK 3+ in 95%, MET 3+ in 60%, PD-L1 TPS 50%, HER2 0. SP142 tumor and immune staining 0%.",
      "Insufficient tissue for broad DNA/RNA sequencing or a BRAF stain. MET gene status remained unresolved. The EGFR L858R stain was uninterpretable; the specific exon 19 deletion stain was negative. AE1/AE3, CK7 and TTF positive; Napsin and CK20 negative."
    ],
    [
      "2026-07",
      "Blood",
      "Guardant360 reported EML4-ALK at 0.2%, with a separate estimate of 0.3% tumor fraction. MSI-high was not detected.",
      "BRAF V600E was not listed. TMB was unavailable. This blood result does not resolve BRAF status in the July pleural sample."
    ]
